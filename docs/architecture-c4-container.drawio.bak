        <mxCell id="ed7" value="Delivers events · manual ack&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i_rabbit" target="c_worker">
          <mxGeometry relative="1" as="geometry" />
