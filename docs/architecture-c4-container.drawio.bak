        <mxCell id="ed9" value="Upserts / deletes vectors&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_worker" target="e_pinecone">
