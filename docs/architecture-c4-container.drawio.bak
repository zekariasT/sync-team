        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#08427B&quot;&gt;&#9632;&lt;/font&gt; Person&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#1168BD&quot;&gt;&#9632;&lt;/font&gt; Owned container&lt;br&gt;&lt;font color=&quot;#438DD5&quot;&gt;&#9632;&lt;/font&gt; Infra (broker / cache / DB)&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#8C8C8C&quot;&gt;&#9632;&lt;/font&gt; External system&lt;br&gt;&lt;br&gt;&#8212;&#8212; Synchronous (HTTPS / SQL / AMQP)&lt;br&gt;- - - Async realtime (WebSocket / pub-sub)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#CCCCCC;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
