        <mxCell id="ed4" value="Pushes kb:indexed&lt;br&gt;[WebSocket]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="c_api" target="c_web">
          <mxGeometry relative="1" as="geometry" />
