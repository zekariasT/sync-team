        <mxCell id="d_maria" value="&lt;b&gt;MariaDB&lt;/b&gt;&lt;br&gt;[Relational DB · Prisma]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Users, teams, document metadata&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="560" width="190" height="95" as="geometry" />
