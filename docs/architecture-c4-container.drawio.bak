<mxfile host="app.diagrams.net" type="device">
  <diagram id="syncpoint-c4-container" name="SyncPoint OS — C4 Container">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SyncPoint OS — C4 Model · Level 2 (Container Diagram)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- System boundary -->
        <mxCell id="boundary" value="SyncPoint OS [Software System]" style="rounded=1;dashed=1;fillColor=none;strokeColor=#444444;verticalAlign=top;align=left;fontStyle=2;fontColor=#444444;fontSize=14;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="130" width="1060" height="650" as="geometry" />
        </mxCell>

        <!-- Person -->
        <mxCell id="p_user" value="&lt;b&gt;Team Member&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Uses the dashboard in a browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="130" height="110" as="geometry" />
        </mxCell>

        <!-- External systems (grey, C4 convention) -->
        <mxCell id="e_clerk" value="&lt;b&gt;Clerk&lt;/b&gt;&lt;br&gt;[External · Auth]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Authentication &amp; JWT issuer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_gemini" value="&lt;b&gt;Google Gemini API&lt;/b&gt;&lt;br&gt;[External · AI]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Embeddings + LLM answers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="820" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_pinecone" value="&lt;b&gt;Pinecone&lt;/b&gt;&lt;br&gt;[External · Vector DB]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stores &amp; searches embeddings&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="390" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- Owned containers (C4 blue) -->
        <mxCell id="c_web" value="&lt;b&gt;Web App&lt;/b&gt;&lt;br&gt;[Container: Next.js 15 · React 19]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Server-rendered dashboard UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="390" width="180" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_api" value="&lt;b&gt;Core API&lt;/b&gt;&lt;br&gt;[Container: NestJS]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;REST + socket.io gateway · owns the DB · publishes work · relays realtime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="200" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c_worker" value="&lt;b&gt;AI Worker&lt;/b&gt;&lt;br&gt;[Container: NestJS microservice]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Headless queue consumer · chunks, embeds &amp; upserts vectors (no HTTP)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="380" width="200" height="115" as="geometry" />
        </mxCell>

        <!-- Infrastructure (lighter blue) -->
        <mxCell id="i_rabbit" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;[Message broker]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Durable queue &quot;kb_indexing_queue&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="200" width="180" height="85" as="geometry" />
        </mxCell>
