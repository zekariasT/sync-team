        <!-- Edges -->
        <mxCell id="ed1" value="Uses&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_user" target="c_web">
