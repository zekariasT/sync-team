        <mxCell id="ed6" value="Publishes document.uploaded / .deleted&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_api" target="i_rabbit">
          <mxGeometry relative="1" as="geometry" />
